# ==============================================================================
# LiveEuy Catalog Service - Environment Configuration Template
# Salin file ini menjadi .env dan isi dengan nilai sebenarnya
# JANGAN commit file .env ke version control!
# ==============================================================================

# Server
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL / Neon DB
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/liveeuy-catalog-db
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# ------------------------------------------------------------------------------
# JWT / Auth Service Integration
# Format: URL endpoint JWKS dari auth-service
# ------------------------------------------------------------------------------
JWK_SET_URI=http://localhost:8080/.well-known/jwks.json
JWT_ISSUER=liveeuy-auth-service

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage
# Cara mendapatkan credentials:
#   1. Login ke Cloudflare Dashboard → pilih akun
#   2. Klik "R2 Object Storage" di sidebar
#   3. Klik "Manage R2 API Tokens" → "Create API Token"
#   4. Pilih permission: Object Read & Write → Specific bucket
#   5. Salin Access Key ID dan Secret Access Key
#
# Account ID:
#   Cloudflare Dashboard → kanan atas, atau URL: dash.cloudflare.com/<ACCOUNT_ID>
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id

# API Token (buat di: Cloudflare Dashboard → R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Nama bucket R2 (harus sudah dibuat di Cloudflare Dashboard)
R2_BUCKET_NAME=liveeuy-catalog

# Custom domain publik untuk akses file (opsional)
# Jika diisi, URL yang dikembalikan API menggunakan domain ini
# Setup: Cloudflare Dashboard → R2 → Bucket → Settings → Custom Domains
# Contoh: https://cdn.liveeuy.com
R2_PUBLIC_URL=

# Durasi presigned URL download dalam menit (default 60 = 1 jam)
R2_PRESIGN_EXPIRY_MINUTES=60
