{
    "swagger": "2.0",
    "info": {
        "description": "Authentication \u0026 User Management Service for LiveEuy platform.",
        "title": "Auth Service API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "email": "support@liveeuy.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/health": {
            "get": {
                "description": "Service health status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Healthy",
                        "schema": {
                            "$ref": "#/definitions/handler.BaseResponseData"
                        }
                    }
                }
            }
        },
        "/api/ping": {
            "get": {
                "description": "Ping test endpoint",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Ping check",
                "responses": {
                    "200": {
                        "description": "Pong",
                        "schema": {
                            "$ref": "#/definitions/handler.BaseResponseData"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/change-password": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Change password with validation against current password",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Change user password",
                "parameters": [
                    {
                        "description": "Change Password Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.changePasswordReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Kata sandi berhasil diubah",
                        "schema": {
                            "$ref": "#/definitions/handler.APIResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Kata sandi saat ini salah",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/demo-login": {
            "post": {
                "description": "Fast login for development, testing, and UI persona testing (hafiz / budi)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Demo persona login",
                "parameters": [
                    {
                        "description": "Demo Login Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.demoLoginReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Berhasil masuk via Demo Account",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/handler.APIResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/handler.AuthContractData"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/forgot-password": {
            "post": {
                "description": "Request password reset email",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Forgot password",
                "parameters": [
                    {
                        "description": "Forgot Password Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.forgotPasswordReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Email pemulihan terkirim",
                        "schema": {
                            "$ref": "#/definitions/handler.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/google/callback": {
            "get": {
                "description": "Handles OAuth callback from Google, authenticates the user and returns access and refresh tokens",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "OAuth"
                ],
                "summary": "Google OAuth callback",
                "parameters": [
                    {
                        "type": "string",
                        "description": "OAuth State parameter",
                        "name": "state",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "OAuth Authorization Code",
                        "name": "code",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Google login successful",
                        "schema": {
                            "$ref": "#/definitions/handler.RefreshTokenResponseData"
                        }
                    },
                    "400": {
                        "description": "Missing authorization code",
                        "schema": {
                            "$ref": "#/definitions/handler.BaseResponseData"
                        }
                    },
                    "401": {
                        "description": "CSRF state mismatch or invalid session",
                        "schema": {
                            "$ref": "#/definitions/handler.BaseResponseData"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/handler.BaseResponseData"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/google/login": {
            "get": {
                "description": "Redirects the user to Google OAuth consent page",
                "tags": [
                    "OAuth"
                ],
                "summary": "Initiate Google OAuth login",
                "responses": {
                    "307": {
                        "description": "Redirect to Google OAuth consent URL",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/handler.BaseResponseData"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "description": "Authenticate user using email and password",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "User login",
                "parameters": [
                    {
                        "description": "Login Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.loginReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Berhasil masuk ke LiveEuy",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/handler.APIResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/handler.AuthContractData"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Email atau kata sandi tidak cocok",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "description": "Invalidate the specified refresh token session and clear auth cookie",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "User logout (single device)",
                "parameters": [
                    {
                        "description": "Logout Request (Optional if using Cookie)",
                        "name": "request",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/handler.logoutReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sesi berhasil diakhiri",
                        "schema": {
                            "$ref": "#/definitions/handler.APIResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/logout-all": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Invalidate all active refresh tokens for the authenticated user",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout all devices",
                "responses": {
                    "200": {
                        "description": "Sesi di seluruh perangkat berhasil diakhiri",
                        "schema": {
                            "$ref": "#/definitions/handler.APIResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieve current authenticated user profile",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Get user profile",
                "responses": {
                    "200": {
                        "description": "Profil berhasil dimuat",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/handler.APIResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/handler.UserContractResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    },
                    "404": {
                        "description": "User not found",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/profile": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Update authenticated user's name and avatar",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Update user profile",
                "parameters": [
                    {
                        "description": "Profile Update Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.profileUpdateReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Profil berhasil diperbarui",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/handler.APIResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/handler.UserContractResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/refresh": {
            "post": {
                "description": "Rotate refresh token and generate new access token (from Cookie or JSON body)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Refresh access token",
                "parameters": [
                    {
                        "description": "Refresh Token Request (Optional if using Cookie)",
                        "name": "request",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/handler.refreshTokenReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Token akses berhasil diperbarui",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/handler.APIResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/handler.RefreshContractData"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "401": {
                        "description": "Refresh token tidak valid atau telah dicabut",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "description": "Register a new user with name, email, password, and tier",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "Register Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.registerReq"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Pendaftaran akun berhasil",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/handler.APIResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/handler.AuthContractData"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request / Validation Error",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Email sudah terdaftar di sistem",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/handler.APIErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/reset-password": {
            "post": {
                "description": "Reset password using received token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Authentication"
                ],
                "summary": "Reset password",
                "parameters": [
                    {
                        "description": "Reset Password Request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.resetPasswordReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Kata sandi berhasil direset",
                        "schema": {
                            "$ref": "#/definitions/handler.APIResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.APIErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "AUTH_401_01"
                },
                "details": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handler.ErrorDetail"
                    }
                },
                "error": {
                    "type": "string",
                    "example": "UNAUTHORIZED"
                },
                "message": {
                    "type": "string",
                    "example": "Email atau kata sandi tidak cocok."
                },
                "success": {
                    "type": "boolean",
                    "example": false
                },
                "timestamp": {
                    "type": "string",
                    "example": "2026-09-25T09:30:00Z"
                }
            }
        },
        "handler.APIResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "message": {
                    "type": "string",
                    "example": "Operasi berhasil"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "handler.AuthContractData": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "type": "string",
                    "example": "eyJhbGciOi..."
                },
                "expiresIn": {
                    "type": "integer",
                    "example": 900
                },
                "refreshToken": {
                    "type": "string",
                    "example": "rfk-94a28f73..."
                },
                "tokenType": {
                    "type": "string",
                    "example": "Bearer"
                },
                "user": {
                    "$ref": "#/definitions/handler.UserContractResponse"
                }
            }
        },
        "handler.BaseResponseData": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "error description"
                },
                "message": {
                    "type": "string",
                    "example": "operation successful"
                },
                "status": {
                    "type": "string",
                    "example": "healthy"
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "handler.ErrorDetail": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string",
                    "example": "password"
                },
                "message": {
                    "type": "string",
                    "example": "Kata sandi salah"
                }
            }
        },
        "handler.RefreshContractData": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "type": "string",
                    "example": "eyJhbGciOi..."
                },
                "expiresIn": {
                    "type": "integer",
                    "example": 900
                },
                "refreshToken": {
                    "type": "string",
                    "example": "rfk-new-rotated..."
                },
                "tokenType": {
                    "type": "string",
                    "example": "Bearer"
                }
            }
        },
        "handler.RefreshTokenResponseData": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOi..."
                },
                "refresh_token": {
                    "type": "string",
                    "example": "d0a5f9..."
                },
                "success": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "handler.UserContractResponse": {
            "type": "object",
            "properties": {
                "avatar": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "devices": {
                    "type": "integer"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "memberSince": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                },
                "tier": {
                    "type": "string"
                },
                "watchHours": {
                    "type": "number"
                }
            }
        },
        "handler.changePasswordReq": {
            "type": "object",
            "required": [
                "currentPassword",
                "newPassword"
            ],
            "properties": {
                "currentPassword": {
                    "type": "string",
                    "example": "LiveEuy#2026"
                },
                "newPassword": {
                    "type": "string",
                    "minLength": 6,
                    "example": "LiveEuyUltra#2027"
                }
            }
        },
        "handler.demoLoginReq": {
            "type": "object",
            "required": [
                "persona"
            ],
            "properties": {
                "persona": {
                    "type": "string",
                    "example": "hafiz"
                }
            }
        },
        "handler.forgotPasswordReq": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "arga@example.com"
                }
            }
        },
        "handler.loginReq": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "hafiz@liveeuy.id"
                },
                "password": {
                    "type": "string",
                    "example": "LiveEuy#2026"
                },
                "rememberMe": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "handler.logoutReq": {
            "type": "object",
            "properties": {
                "refreshToken": {
                    "type": "string",
                    "example": "rfk-94a28f73b610c41d99e52e"
                },
                "refresh_token": {
                    "type": "string",
                    "example": "rfk-94a28f73b610c41d99e52e"
                }
            }
        },
        "handler.profileUpdateReq": {
            "type": "object",
            "properties": {
                "avatar": {
                    "type": "string",
                    "example": "https://images.unsplash.com/photo-custom.jpg"
                },
                "name": {
                    "type": "string",
                    "example": "Hafiz Muhammad Al Ikhsan"
                }
            }
        },
        "handler.refreshTokenReq": {
            "type": "object",
            "properties": {
                "refreshToken": {
                    "type": "string",
                    "example": "rfk-94a28f73b610c41d99e52e"
                },
                "refresh_token": {
                    "type": "string",
                    "example": "rfk-94a28f73b610c41d99e52e"
                }
            }
        },
        "handler.registerReq": {
            "type": "object",
            "required": [
                "email",
                "name",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "arga@example.com"
                },
                "name": {
                    "type": "string",
                    "example": "Arga Pratama"
                },
                "password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "PasswordSuper#2026"
                },
                "tier": {
                    "type": "string",
                    "example": "VIP Standard"
                }
            }
        },
        "handler.resetPasswordReq": {
            "type": "object",
            "required": [
                "newPassword",
                "token"
            ],
            "properties": {
                "newPassword": {
                    "type": "string",
                    "minLength": 6,
                    "example": "NewSecurePassword#2026"
                },
                "token": {
                    "type": "string",
                    "example": "rst-tok-84729104857201"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Type \"Bearer\" followed by a space and JWT token.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}