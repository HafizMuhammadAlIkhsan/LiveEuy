# ==============================================================================
# LiveEuy Auth Service - Environment Configuration Template
# ==============================================================================

# Server Port (Default: 8080)
PORT=8080

# PostgreSQL Database Connection URL (GORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liveeuy_auth?sslmode=disable

# Redis Session Storage Connection URL
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Asymmetric JWT Configuration (RS256)
# ------------------------------------------------------------------------------
# Key Identifier header 'kid' included in all issued JWT tokens
JWT_KEY_ID=liveeuy-auth-key-1

# File paths to RSA Private & Public Keys (PEM format)
# Note: If these files do not exist, the auth-service will automatically 
# generate a 2048-bit RSA keypair on startup and save them to the paths below.
JWT_PRIVATE_KEY_PATH=certs/private.pem
JWT_PUBLIC_KEY_PATH=certs/public.pem

# Optional: Raw RSA PEM or Base64 string directly in environment (overrides file paths)
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Access Token expiration time in milliseconds (Default: 900000 = 15 minutes)
JWT_EXPIRATION_MS=900000

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Configuration
# ------------------------------------------------------------------------------
WEB_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
WEB_OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
WEB_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage (Opsional)
# Digunakan untuk: upload foto profil (avatar) user
# Jika tidak diset, fitur upload avatar tidak tersedia namun service tetap berjalan.
#
# Cara mendapatkan credentials:
#   1. Login ke Cloudflare Dashboard → pilih akun
#   2. Klik "R2 Object Storage" di sidebar kiri
#   3. Klik "Manage R2 API Tokens" → "Create API Token"
#   4. Pilih permission: Object Read & Write → Specific bucket: liveeuy-auth
#   5. Salin Access Key ID dan Secret Access Key yang muncul sekali
#
# Account ID ada di: Cloudflare Dashboard → kanan atas sidebar
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Nama bucket untuk auth-service (pisah dari catalog-service)
R2_BUCKET_NAME=liveeuy-auth
# Custom domain publik untuk CDN (opsional)
# Contoh: https://cdn.liveeuy.com
R2_PUBLIC_URL=
