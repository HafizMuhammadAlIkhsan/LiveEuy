# ==============================================================================
# LiveEuy Transcoder Service - Environment Configuration
# ==============================================================================

# Server Port (Default: 8082)
PORT=8082

# Base URL for public streaming access (used by client players)
PUBLIC_STREAM_BASE_URL=http://localhost/api/v1/transcoder/stream

# JWKS Endpoint for asymmetric RS256 token verification
JWK_SET_URI=http://auth-service:8080/.well-known/jwks.json
# Fallback JWKS URI if testing locally outside docker:
# JWK_SET_URI=http://localhost:8080/.well-known/jwks.json

# Expected JWT Issuer
JWT_ISSUER=liveeuy-auth-service

# Catalog Service Webhook URL (for updating videoUrl upon completion)
CATALOG_SERVICE_URL=http://catalog-service:8081/api/v1

# Storage Type: 'local' (future options: 'r2', 's3')
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage

# Concurrency: Maximum number of active FFmpeg transcoding jobs simultaneously
MAX_CONCURRENT_JOBS=2

# Maximum Upload File Size in Bytes (Default: 2GB = 2147483648)
MAX_UPLOAD_SIZE_BYTES=2147483648
